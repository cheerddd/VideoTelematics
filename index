/* ---------------- 渲染 ---------------- */
const LS_DONE='vt-english-mastered-v1', LS_PREF='vt-english-pref-v1';
const done=new Set(JSON.parse(localStorage.getItem(LS_DONE)||'[]'));
const pref=Object.assign({accent:'en-US',rate:'0.95'},JSON.parse(localStorage.getItem(LS_PREF)||'{}'));
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const slug=s=>s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const sayOf=it=>it.s||it.w.replace(/\s*\/\s*/g,', ').replace(/[…]/g,'').replace(/\(([^)]*)\)/g,'$1');
const SPK='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/></svg>';
const CHK='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

let html='', toc='', total=0, coreTotal=0;
const seen=new Set();
DATA.forEach((part,pi)=>{
  const pc=part.subs.reduce((n,s)=>n+s.items.length,0);
  toc+=`<a class="part" href="#${part.id}" data-for="${part.id}"><span>${esc(part.title)}</span><span class="n">${pc}</span></a>`;
  html+=`<section class="part" id="${part.id}" data-part><div class="part-h"><span class="idx">0${pi+1}</span><h2>${esc(part.title)}</h2><span class="en-t">${esc(part.en)}</span></div><p class="part-desc">${esc(part.desc)}</p>`;
  part.subs.forEach(sub=>{
    toc+=`<a class="subl" href="#${sub.id}" data-for="${sub.id}"><span>${esc(sub.title)}</span><span class="n">${sub.items.length}</span></a>`;
    html+=`<div class="sub" id="${sub.id}" data-sub><h3>${esc(sub.title)}<small>${esc(sub.en)}</small></h3><div class="grid">`;
    sub.items.forEach(it=>{
      let id=sub.id+'-'+slug(it.w); while(seen.has(id)) id+='x'; seen.add(id);
      total++; if(it.c) coreTotal++;
      const q=[it.w,it.z,it.e,it.ez,it.n].join(' ').toLowerCase();
      html+=`<article class="card${it.c?' core':''}${done.has(id)?' done':''}" data-id="${id}" data-q="${esc(q)}">
        <div class="head">
          <span class="w en">${esc(it.w)}</span>
          <button class="spk" data-say="${esc(sayOf(it))}" aria-label="朗读 ${esc(it.w)}">${SPK}</button>
          ${it.p?`<span class="ipa">${esc(it.p)}</span>`:''}
          ${it.t?`<span class="pos">${esc(it.t)}</span>`:''}
          ${it.c?'<span class="core-b">必背</span>':''}
        </div>
        <button class="mk" aria-label="标记为已掌握" aria-pressed="${done.has(id)}">${CHK}</button>
        <div class="mean zh">${esc(it.z)}</div>
        <div class="ex">
          <button class="spk" data-say="${esc(it.e)}" aria-label="朗读例句">${SPK}</button>
          <div class="ex-body"><p class="ex-en en">${esc(it.e)}</p><p class="ex-zh zh">${esc(it.ez)}</p></div>
        </div>
        ${it.n?`<p class="note">${esc(it.n)}</p>`:''}
      </article>`;
    });
    html+='</div></div>';
  });
  html+='</section>';
});
document.getElementById('main').innerHTML=html;
document.getElementById('toc').innerHTML=toc;

const cards=[...document.querySelectorAll('.card')];
const counts=DATA.map(p=>[p.title,p.subs.reduce((n,s)=>n+s.items.length,0)]);
document.getElementById('stats').innerHTML=
  counts.map(([t,n])=>`<div class="stat"><b>${n}</b><span>${esc(t)}</span></div>`).join('')+
  `<div class="stat"><b>${coreTotal}</b><span>其中必背</span></div>`+
  `<div class="stat progress"><b id="pg-n">0 / ${total}</b><span>已掌握</span><div class="bar"><i id="pg-bar"></i></div></div>`;

function saveDone(){localStorage.setItem(LS_DONE,JSON.stringify([...done]))}
function updateProgress(){
  const n=cards.filter(c=>done.has(c.dataset.id)).length;
  document.getElementById('pg-n').textContent=`${n} / ${total}`;
  document.getElementById('pg-bar').style.width=(n/total*100)+'%';
}

/* ---------------- 筛选 ---------------- */
const st={q:'',coreOnly:false,mastery:'all'};
function apply(){
  let shown=0;
  cards.forEach(c=>{
    const matchesMastery=st.mastery==='all'||(st.mastery==='done'&&c.classList.contains('done'))||(st.mastery==='pending'&&!c.classList.contains('done'));
    const ok=(!st.q||c.dataset.q.includes(st.q))&&(!st.coreOnly||c.classList.contains('core'))&&matchesMastery;
    c.hidden=!ok; if(ok) shown++;
  });
  document.querySelectorAll('[data-sub]').forEach(s=>{
    const any=!!s.querySelector('.card:not([hidden])'); s.hidden=!any;
    const a=document.querySelector(`.toc a[data-for="${s.id}"]`);
    if(a){a.classList.toggle('dim',!any);a.querySelector('.n').textContent=s.querySelectorAll('.card:not([hidden])').length;}
  });
  document.querySelectorAll('[data-part]').forEach(p=>{
    const n=p.querySelectorAll('.card:not([hidden])').length; p.hidden=!n;
    const a=document.querySelector(`.toc a[data-for="${p.id}"]`);
    if(a){a.classList.toggle('dim',!n);a.querySelector('.n').textContent=n;}
  });
  const emptyEl=document.getElementById('empty');
  if(shown===0){
    emptyEl.textContent=st.mastery==='done'
      ?'暂时没有已掌握的词条。先点击任意词条右上角的圆圈标记掌握，再使用此筛选。'
      :'没有匹配的内容，换个关键词试试。';
  }
  emptyEl.classList.toggle('show',shown===0);
  document.getElementById('result').textContent=shown===total?`共 ${total} 条`:`显示 ${shown} / ${total} 条`;
}
const qEl=document.getElementById('q');
qEl.addEventListener('input',()=>{st.q=qEl.value.trim().toLowerCase();apply()});
document.addEventListener('keydown',e=>{
  if(e.key==='/'&&document.activeElement!==qEl){e.preventDefault();qEl.focus()}
  if(e.key==='Escape'&&document.activeElement===qEl){qEl.value='';st.q='';apply();qEl.blur()}
});
const coreOnlyBtn=document.getElementById('coreOnly');
coreOnlyBtn.addEventListener('click',()=>{
  st.coreOnly=!st.coreOnly;
  coreOnlyBtn.setAttribute('aria-pressed',String(st.coreOnly));
  apply();
});
const masteryButtons={done:document.getElementById('showDone'),pending:document.getElementById('hideDone')};
function setMasteryFilter(mode){
  st.mastery=st.mastery===mode?'all':mode;
  Object.entries(masteryButtons).forEach(([key,button])=>button.setAttribute('aria-pressed',String(st.mastery===key)));
  apply();
}
masteryButtons.done.addEventListener('click',()=>setMasteryFilter('done'));
masteryButtons.pending.addEventListener('click',()=>setMasteryFilter('pending'));

/* ---------------- 分段按钮 ---------------- */
function seg(id,val,on){
  const g=document.getElementById(id);
  const set=v=>{g.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.v===v));on(v)};
  g.addEventListener('click',e=>{const b=e.target.closest('button');if(b)set(b.dataset.v)});
  set(val);
}
seg('mode','all',v=>{document.body.dataset.mode=v;document.querySelectorAll('.rv').forEach(x=>x.classList.remove('rv'))});
seg('accent',pref.accent,v=>{pref.accent=v;localStorage.setItem(LS_PREF,JSON.stringify(pref))});
seg('rate',pref.rate,v=>{pref.rate=v;localStorage.setItem(LS_PREF,JSON.stringify(pref))});

/* ---------------- 朗读 ---------------- */
const PREFERRED={'en-US':['Samantha','Google US English','Microsoft Aria','Alex','Allison','Ava'],
                 'en-GB':['Daniel','Google UK English Female','Google UK English Male','Microsoft Sonia','Serena','Kate']};
let voices=[];
function loadVoices(){voices=('speechSynthesis' in window)?speechSynthesis.getVoices():[]}
if('speechSynthesis' in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices}
/* macOS 自带的搞怪音色，兜底时跳过 */
const NOVELTY=/^(Albert|Bad News|Bahh|Bells|Boing|Bubbles|Cellos|Good News|Jester|Organ|Superstar|Trinoids|Whisper|Wobble|Zarvox|Grandma|Grandpa|Junior|Ralph|Fred|Kathy|Nicky)\b/;
function pickVoice(lang){
  const pool=voices.filter(v=>v.lang&&v.lang.replace('_','-').toLowerCase()===lang.toLowerCase()&&!NOVELTY.test(v.name));
  for(const name of PREFERRED[lang]){const v=pool.find(v=>v.name.includes(name));if(v) return v}
  return pool[0]||voices.find(v=>/^en/i.test(v.lang)&&!NOVELTY.test(v.name))||null;
}
let speakingBtn=null;
function speak(text,btn){
  if(!('speechSynthesis' in window)){toast('当前浏览器不支持朗读，请用 Chrome 或 Safari 打开');return}
  speechSynthesis.cancel();
  if(speakingBtn) speakingBtn.classList.remove('on');
  const u=new SpeechSynthesisUtterance(text);
  u.lang=pref.accent; u.rate=parseFloat(pref.rate);
  const v=pickVoice(pref.accent); if(v) u.voice=v;
  speakingBtn=btn; btn.classList.add('on');
  u.onend=u.onerror=()=>btn.classList.remove('on');
  speechSynthesis.speak(u);
}

/* ---------------- 点击事件 ---------------- */
document.getElementById('main').addEventListener('click',e=>{
  const spk=e.target.closest('.spk');
  if(spk){speak(spk.dataset.say,spk);return}
  const mk=e.target.closest('.mk');
  if(mk){
    const card=mk.closest('.card'),id=card.dataset.id;
    if(done.has(id)){done.delete(id);card.classList.remove('done')}else{done.add(id);card.classList.add('done');toast('已标记为掌握')}
    mk.setAttribute('aria-pressed',done.has(id));
    saveDone();updateProgress();if(st.mastery!=='all') apply();return;
  }
  const mode=document.body.dataset.mode;
  const blurred=mode==='hide-zh'?e.target.closest('.zh'):mode==='hide-en'?e.target.closest('.en'):null;
  if(blurred) blurred.classList.toggle('rv');
});

let tt;
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('show'),2500)}

updateProgress();apply();
</script>
