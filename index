<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Video Telematics 行业英语 · 词汇 / 短语 / 搭配</title>
<style>
  :root{
    --brand:#6366F1; --brand-light:#EEF2FF; --brand-dark:#4F46E5;
    --bg:#F8F9FC; --surface-2:#F0F2F7; --chrome:#EDEEF3;
    --border:#E2E5EE; --text:#0F1624; --text-2:#4B5269; --muted:#8890A8;
    --success:#0B7B52; --success-bg:#E6F5EF;
    --warning:#92600A; --warning-bg:#FEF3E2;
    --header:#2C3344;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;scroll-padding-top:76px}
  body{margin:0;background:var(--bg);color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Helvetica Neue",Arial,sans-serif;
    font-size:14px;line-height:1.55;-webkit-font-smoothing:antialiased}
  button{font:inherit;color:inherit;cursor:pointer}
  button:focus-visible,input:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

  /* ---------- Hero ---------- */
  .hero{background:var(--header);color:#fff;padding:32px 24px 28px}
  .hero-in{max-width:1280px;margin:0 auto}
  .hero h1{margin:0;font-size:26px;font-weight:700;letter-spacing:.01em}
  .hero .sub{margin:6px 0 0;color:rgba(255,255,255,.62);font-size:14px}
  .stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
  .stat{background:rgba(255,255,255,.08);border-radius:10px;padding:10px 14px;min-width:112px}
  .stat b{display:block;font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}
  .stat span{font-size:12px;color:rgba(255,255,255,.6)}
  .progress{flex:1 1 260px;min-width:240px}
  .bar{height:6px;border-radius:6px;background:rgba(255,255,255,.14);margin-top:8px;overflow:hidden}
  .bar i{display:block;height:100%;width:0;background:#A5B4FC;border-radius:6px;transition:width .3s}
  .tips{margin:20px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px}
  .tips li{background:rgba(255,255,255,.06);border-radius:10px;padding:10px 12px;font-size:12.5px;color:rgba(255,255,255,.78)}
  .tips li b{color:#fff;font-weight:600}

  /* ---------- Toolbar ---------- */
  .toolbar{position:sticky;top:0;z-index:20;background:rgba(248,249,252,.94);backdrop-filter:blur(8px);
    box-shadow:0 1px 0 var(--border)}
  .toolbar-in{max-width:1280px;margin:0 auto;padding:10px 24px;display:flex;flex-wrap:wrap;align-items:center;gap:10px}
  .search{position:relative;flex:0 1 260px}
  .search input{width:100%;height:34px;border:1px solid var(--border);border-radius:8px;background:#fff;
    padding:0 30px 0 32px;font-size:13px;color:var(--text)}
  .search svg{position:absolute;left:10px;top:9px;color:var(--muted)}
  .search kbd{position:absolute;right:8px;top:8px;font:11px/16px ui-monospace,Menlo,monospace;color:var(--muted);
    border:1px solid var(--border);border-radius:4px;padding:0 4px;background:var(--bg)}
  .seg{display:inline-flex;background:var(--chrome);border-radius:8px;padding:2px}
  .seg button{border:0;background:transparent;height:30px;padding:0 10px;border-radius:6px;font-size:12.5px;color:var(--text-2)}
  .seg button[aria-pressed="true"]{background:#fff;color:var(--brand);font-weight:600;box-shadow:0 1px 2px rgba(15,22,36,.08)}
  .lbl{font-size:12px;color:var(--muted);margin-right:-4px}
  .chk{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 10px;border:1px solid var(--border);
    border-radius:8px;background:#fff;font-size:12.5px;color:var(--text-2);user-select:none}
  .chk[aria-pressed="true"]{border-color:var(--brand);color:var(--brand);background:var(--brand-light);font-weight:600}
  .spacer{flex:1}
  .result{font-size:12px;color:var(--muted)}

  /* ---------- Layout ---------- */
  .layout{max-width:1280px;margin:0 auto;padding:24px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:24px}
  .toc{position:sticky;top:76px;align-self:start;max-height:calc(100vh - 96px);overflow:auto;font-size:13px}
  .toc a{display:flex;justify-content:space-between;gap:8px;color:var(--text-2);text-decoration:none;padding:5px 10px;border-radius:8px}
  .toc a:hover{background:var(--chrome);color:var(--text)}
  .toc a.part{font-weight:600;color:var(--text);margin-top:12px}
  .toc a.part:first-child{margin-top:0}
  .toc a.subl{padding-left:20px;font-size:12.5px}
  .toc a .n{color:var(--muted);font-variant-numeric:tabular-nums;font-size:12px}
  .toc a.dim{opacity:.35}

  .part{margin-bottom:36px}
  .part-h{display:flex;align-items:baseline;gap:12px;margin:0 0 4px}
  .part-h .idx{font:600 13px/1 ui-monospace,Menlo,monospace;color:var(--brand);background:var(--brand-light);
    padding:5px 8px;border-radius:6px}
  .part-h h2{margin:0;font-size:22px}
  .part-h .en-t{color:var(--muted);font-size:14px}
  .part-desc{margin:4px 0 16px;color:var(--text-2);font-size:13px}
  .sub{margin-bottom:24px}
  .sub h3{margin:0 0 10px;font-size:15px;display:flex;align-items:baseline;gap:8px}
  .sub h3 small{font-weight:400;color:var(--muted);font-size:12.5px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:12px}

  /* ---------- Card ---------- */
  .card{background:#fff;border-radius:10px;padding:14px 16px 12px;box-shadow:0 1px 2px rgba(15,22,36,.05);
    display:flex;flex-direction:column;gap:6px;position:relative;transition:background .2s}
  .card.done{background:#FBFCFE}
  .card.done .w{color:var(--success)}
  .head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-right:28px}
  .w{font-size:17px;font-weight:700;letter-spacing:.005em}
  .ipa{font-family:"Lucida Grande","Lucida Sans Unicode","Segoe UI",Arial,sans-serif;font-size:13px;color:var(--text-2)}
  .pos{font-size:11px;color:var(--muted);background:var(--surface-2);border-radius:4px;padding:1px 6px}
  .core-b{font-size:11px;color:var(--warning);background:var(--warning-bg);border-radius:4px;padding:1px 6px;font-weight:600}
  .mean{font-size:14px;color:var(--text);font-weight:500}
  .ex{display:flex;gap:6px;align-items:flex-start;background:var(--bg);border-radius:8px;padding:8px 10px 8px 6px;margin-top:2px}
  .ex-body{flex:1;min-width:0}
  .ex-en{margin:0;font-size:13.5px;color:var(--text)}
  .ex-zh{margin:2px 0 0;font-size:12.5px;color:var(--text-2)}
  .note{margin:0;font-size:12px;color:var(--text-2);background:var(--brand-light);border-radius:8px;padding:6px 10px}
  .note::before{content:"提示 ";font-weight:600;color:var(--brand)}

  .spk{border:0;background:transparent;width:26px;height:26px;border-radius:6px;display:inline-flex;align-items:center;
    justify-content:center;color:var(--brand);flex:none}
  .spk:hover{background:var(--brand-light)}
  .spk.on{background:var(--brand);color:#fff}
  .mk{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;border:1.5px solid var(--border);
    background:#fff;color:transparent;display:inline-flex;align-items:center;justify-content:center}
  .mk:hover{border-color:var(--success);color:var(--success)}
  .card.done .mk{background:var(--success);border-color:var(--success);color:#fff}

  /* ---------- Self-test blur ---------- */
  body[data-mode="hide-zh"] .zh:not(.rv),
  body[data-mode="hide-en"] .en:not(.rv){filter:blur(6px);cursor:pointer;user-select:none;transition:filter .15s}
  body[data-mode="hide-zh"] .zh:not(.rv):hover,
  body[data-mode="hide-en"] .en:not(.rv):hover{filter:blur(4px)}

  .empty{display:none;text-align:center;color:var(--muted);padding:60px 0;font-size:14px}
  .empty.show{display:block}
  .foot{color:var(--muted);font-size:12px;text-align:center;padding:12px 0 40px}

  #toast{position:fixed;right:24px;bottom:24px;z-index:9999;background:var(--header);color:#fff;font-size:13px;
    padding:10px 14px;border-radius:10px;opacity:0;transform:translateY(8px);transition:all .2s;pointer-events:none}
  #toast.show{opacity:1;transform:none}

  @media (max-width:980px){
    .layout{grid-template-columns:1fr}
    .toc{display:none}
    .grid{grid-template-columns:1fr}
  }
  /* ---------- Mobile ---------- */
  @media (max-width:720px){
    html{scroll-padding-top:214px}
    body{font-size:15px;line-height:1.6}
    .hero{padding:22px 16px 20px}
    .hero h1{font-size:23px;line-height:1.25}
    .hero .sub{font-size:13px;line-height:1.6}
    .stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:16px}
    .stat{min-width:0;padding:9px 10px;border-radius:8px}
    .stat b{font-size:18px}
    .progress{grid-column:1 / -1;min-width:0}
    .tips{grid-template-columns:1fr;gap:7px;margin-top:16px}
    .tips li{font-size:12.5px;padding:9px 10px}

    .toolbar-in{padding:9px 12px;gap:8px;align-items:stretch}
    .search{flex:1 0 100%}
    .search input{height:40px;font-size:14px}
    .search svg{top:13px}
    .search kbd{top:11px}
    .lbl{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
    .seg{min-width:0}
    #mode{flex:1 0 100%}
    #accent,#rate{flex:1 1 calc(50% - 4px)}
    .seg button{flex:1;min-width:0;height:36px;padding:0 7px;font-size:12px;white-space:nowrap}
    .chk{flex:1 1 calc(33.333% - 6px);justify-content:center;height:38px;padding:0 7px;font-size:12px;white-space:nowrap}
    .spacer{display:none}
    .result{flex:1 0 100%;text-align:right;padding:0 2px;font-size:12px}

    .layout{padding:18px 12px;gap:0}
    .part{margin-bottom:30px;scroll-margin-top:220px}
    .part-h{align-items:flex-start;gap:8px;flex-wrap:wrap}
    .part-h .idx{margin-top:3px}
    .part-h h2{font-size:20px;line-height:1.35}
    .part-h .en-t{font-size:13px;margin-left:38px;margin-top:-7px;flex-basis:calc(100% - 38px)}
    .part-desc{font-size:13px;margin:6px 0 14px}
    .sub{margin-bottom:20px;scroll-margin-top:220px}
    .sub h3{font-size:16px;line-height:1.4;flex-wrap:wrap;gap:3px 8px}
    .sub h3 small{font-size:12px}
    .grid{gap:10px}
    .card{padding:13px 14px 12px;border-radius:10px;gap:7px}
    .head{gap:6px;padding-right:30px}
    .w{font-size:16px;overflow-wrap:anywhere}
    .ipa{font-size:12px;overflow-wrap:anywhere}
    .mean{font-size:14px}
    .ex{padding:9px 9px 9px 5px;gap:5px}
    .ex-en{font-size:13px;line-height:1.55}
    .ex-zh{font-size:12.5px;line-height:1.55}
    .note{font-size:12px;line-height:1.55}
    .spk{width:32px;height:32px}
    .mk{width:32px;height:32px;top:9px;right:9px}
    .foot{padding:6px 4px 26px;font-size:11.5px}
    #toast{left:16px;right:16px;bottom:16px;text-align:center;padding:10px 12px}
  }
  @media (max-width:380px){
    .hero h1{font-size:21px}
    .seg button{padding:0 5px;font-size:11.5px}
    .chk{font-size:11.5px}
    .part-h h2{font-size:19px}
  }
  @media print{
    .toolbar,.toc,.spk,.mk,#toast{display:none!important}
    .hero{background:#fff;color:var(--text);padding:0 0 12px}
    .hero .sub,.stat span,.tips li{color:var(--text-2)}
    .stat,.tips li{background:var(--surface-2)}
    .layout{display:block;padding:0}
    .card{box-shadow:none;border:1px solid var(--border);break-inside:avoid}
    .zh,.en{filter:none!important}
    [hidden]{display:none!important}
  }
</style>
</head>
<body data-mode="all">

<header class="hero">
  <div class="hero-in">
    <h1>Video Telematics 行业英语</h1>
    <p class="sub">写给和海外客户打交道的产品经理：必备词汇、常用短语、高频搭配，每条都配例句和中文翻译</p>
    <div class="stats" id="stats"></div>
    <ul class="tips">
      <li><b>① 先学「必背」</b>：打开工具栏的「只看必背」开关，先把最常用的那部分吃透。</li>
      <li><b>② 跟读</b>：点喇叭听发音，可切换美音 / 英音和慢速。欧洲客户多听英音。</li>
      <li><b>③ 自测</b>：选「遮中文」或「遮英文」，看着一边回忆另一边，点模糊处看答案。</li>
      <li><b>④ 打勾</b>：学会一条就点右上角的圆圈，进度自动保存在这台电脑的浏览器里。</li>
    </ul>
  </div>
</header>

<div class="toolbar">
  <div class="toolbar-in">
    <label class="search" aria-label="搜索">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="搜英文或中文，如 误报" autocomplete="off">
      <kbd>/</kbd>
    </label>
    <span class="lbl">模式</span>
    <div class="seg" id="mode" role="group" aria-label="学习模式">
      <button data-v="all" aria-pressed="true">全部显示</button>
      <button data-v="hide-zh" aria-pressed="false">遮中文</button>
      <button data-v="hide-en" aria-pressed="false">遮英文</button>
    </div>
    <span class="lbl">发音</span>
    <div class="seg" id="accent" role="group" aria-label="发音口音">
      <button data-v="en-US" aria-pressed="true">美音</button>
      <button data-v="en-GB" aria-pressed="false">英音</button>
    </div>
    <div class="seg" id="rate" role="group" aria-label="语速">
      <button data-v="0.95" aria-pressed="true">正常</button>
      <button data-v="0.7" aria-pressed="false">慢速</button>
    </div>
    <button class="chk" id="coreOnly" aria-pressed="false">只看必背</button>
    <button class="chk" id="showDone" aria-pressed="false">只看已掌握</button>
    <button class="chk" id="hideDone" aria-pressed="false">隐藏已掌握</button>
    <span class="spacer"></span>
    <span class="result" id="result"></span>
  </div>
</div>

<div class="layout">
  <nav class="toc" id="toc" aria-label="目录"></nav>
  <main>
    <div id="main"></div>
    <div class="empty" id="empty" role="status" aria-live="polite">没有匹配的内容，换个关键词试试。</div>
    <p class="foot">例句中的数字仅为示范，实际沟通请换成真实数据 · 学习进度只保存在本机浏览器</p>
  </main>
</div>
<div id="toast" role="status" aria-live="polite"></div>

<script>
/* v(英文, 音标, 词性, 中文, 例句, 例句翻译, 提示, 是否必背, 朗读文本) */
function v(w,p,t,z,e,ez,n,c,s){return {w,p,t,z,e,ez,n,c:!!c,s}}

const DATA = [
{ id:'A', title:'必备词汇', en:'Vocabulary', desc:'按主题分组。行业名词、设备、AI 事件、视频数据、平台功能，再加上产品经理日常工作、技术支持和商务谈判里最常出现的词。', subs:[

{ id:'A1', title:'行业与角色', en:'Industry & Roles', items:[
v("video telematics","/ˈvɪdioʊ ˌtɛləˈmætɪks/","n.","视频车联网（视频 + 车辆数据）","Video telematics gives fleet managers both the data and the video behind every event.","视频车联网让车队管理者既能看到每个事件的数据，也能看到背后的视频。","这就是你所在行业的英文名，自我介绍可以说：I work in video telematics.",1),
v("telematics","/ˌtɛləˈmætɪks/","n.","车联网；远程车辆信息服务","Are you using any telematics system at the moment?","你们目前在用什么车联网系统吗？","重音在 -MA-。telematics provider = 车联网服务商（也就是同行）。",1),
v("fleet","/fliːt/","n.","车队；一家公司的全部车辆","How many vehicles are there in your fleet?","你们车队一共有多少辆车？","注意和 flight /flaɪt/ 区分。fleet size = 车队规模。",1),
v("fleet management","/ˌfliːt ˈmænɪdʒmənt/","n.","车队管理","Fleet management is no longer just about GPS tracking.","车队管理早已不只是 GPS 定位了。","",1),
v("fleet operator","/ˌfliːt ˈɑːpəreɪtər/","n.","车队运营方（拥有并运营车队的公司）","Most fleet operators care about three things: safety, cost and uptime.","大多数车队运营方关心三件事：安全、成本和车辆出勤。","",0),
v("fleet manager","/ˌfliːt ˈmænɪdʒər/","n.","车队经理","The fleet manager is usually the main user of the platform.","车队经理通常是平台的主要使用者。","",1),
v("safety manager","/ˈseɪfti ˌmænɪdʒər/","n.","安全经理","The safety manager reviews the high-risk events every morning.","安全经理每天早上审看高风险事件。","",0),
v("dispatcher","/dɪˈspætʃər/","n.","调度员","Dispatchers need to know where every vehicle is in real time.","调度员需要实时知道每辆车在哪。","dispatch (v.) = 调度、派车。",0),
v("logistics","/loʊˈdʒɪstɪks/","n.","物流","Most of our customers are in logistics and public transport.","我们的客户大多在物流和公共交通领域。","",0),
v("long-haul","/ˌlɔːŋ ˈhɔːl/","adj.","长途（干线）运输的","Fatigue is the biggest risk for long-haul drivers.","疲劳是长途司机面临的最大风险。","短途是 short-haul。",0),
v("last-mile delivery","/ˌlæst ˈmaɪl dɪˈlɪvəri/","n.","最后一公里配送","Last-mile delivery drivers can make more than a hundred stops a day.","做最后一公里配送的司机一天可能要停靠上百个点。","",0),
v("public transit","/ˌpʌblɪk ˈtrænzɪt/","n.","公共交通","In public transit, passenger safety always comes first.","在公共交通领域，乘客安全永远第一。","美式说法；英式多说 public transport。",0),
v("commercial vehicle","/kəˈmɜːrʃəl ˈviːəkəl/","n.","商用车","This camera is designed for commercial vehicles, not private cars.","这款摄像头是为商用车设计的，不是私家车。","vehicle 中间的 h 不发音。",0),
v("heavy-duty truck","/ˌhɛvi ˈduːti trʌk/","n.","重型卡车","Heavy-duty trucks need more cameras because of their large blind spots.","重卡盲区大，需要装更多摄像头。","",0),
v("trailer","/ˈtreɪlər/","n.","挂车","Some customers want to track their trailers separately from the trucks.","有些客户希望把挂车和车头分开追踪。","车头 = tractor / tractor unit。",0),
v("asset","/ˈæsɛt/","n.","资产（车辆、挂车、集装箱等）","They also want to track non-powered assets like containers.","他们还想追踪集装箱这类无动力资产。","asset tracking = 资产追踪。",0),
v("TSP","/ˌtiː ɛs ˈpiː/","n.","车联网服务商（Telematics Service Provider）","Many TSPs integrate our devices into their own platforms.","很多车联网服务商把我们的设备接入他们自己的平台。","按字母读 T-S-P。",1,"T S P"),
v("OEM","/ˌoʊ iː ˈɛm/","n.","原始设备制造商（车辆语境多指主机厂）","Some truck OEMs now install cameras at the factory.","一些卡车主机厂现在出厂就预装摄像头。","按字母读。前装 = factory-installed，后装 = aftermarket。",0,"O E M"),
v("distributor / reseller","/dɪˈstrɪbjətər/ · /ˈriːsɛlər/","n.","分销商 / 经销商","In Mexico, we work through a local distributor.","在墨西哥，我们通过当地分销商合作。","",0),
v("system integrator","/ˈsɪstəm ˈɪntəˌɡreɪtər/","n.","系统集成商（SI）","The system integrator will handle installation and integration.","安装和系统对接由系统集成商负责。","",0),
v("end customer","/ˌɛnd ˈkʌstəmər/","n.","终端客户","Our partner sells the complete solution to the end customer.","我们的合作伙伴把整套方案卖给终端客户。","",0),
v("insurer","/ɪnˈʃʊrər/","n.","保险公司","Insurers are very interested in video evidence.","保险公司对视频证据非常感兴趣。","",0),
v("competitor","/kəmˈpɛtɪtər/","n.","竞争对手","How are you different from your competitors?","你们和竞争对手有什么区别？","客户最常问的问题之一，要提前准备好答案。",1)
]},

{ id:'A2', title:'硬件与安装', en:'Hardware & Installation', items:[
v("dashcam","/ˈdæʃkæm/","n.","行车记录仪（dash camera）","The AI dashcam can detect phone use and fatigue.","这款 AI 行车记录仪能识别打电话和疲劳驾驶。","",1),
v("MDVR","/ˌɛm diː viː ˈɑːr/","n.","车载硬盘录像机（Mobile DVR，可接多路摄像头）","Buses usually use an MDVR because they need more cameras.","公交车通常用 MDVR，因为要接更多摄像头。","按字母读 M-D-V-R。",1,"M D V R"),
v("channel","/ˈtʃænəl/","n.","路（视频通道）","We need a four-channel system: front, cabin, left side and rear.","我们需要一套四路系统：前视、车内、左侧和后视。","中文的“几路”= X-channel，例如 8-channel MDVR。",1),
v("road-facing camera","/ˈroʊd ˌfeɪsɪŋ ˈkæmərə/","n.","前视摄像头（拍路面）","The road-facing camera records everything in front of the vehicle.","前视摄像头会记录车辆前方的一切。","也叫 forward-facing camera / front camera。",0),
v("driver-facing camera","/ˈdraɪvər ˌfeɪsɪŋ ˈkæmərə/","n.","车内摄像头（拍司机）","Some drivers don't like the driver-facing camera at first.","一开始有些司机不太接受车内摄像头。","也叫 in-cab camera / cabin camera。",1),
v("side camera","/ˈsaɪd ˌkæmərə/","n.","侧视摄像头","A side camera helps cover the blind spot when the bus turns.","侧视摄像头能在公交车转弯时覆盖盲区。","",0),
v("sensor","/ˈsɛnsər/","n.","传感器","The sensor data is uploaded together with the video.","传感器数据会和视频一起上传。","",0),
v("G-sensor","/ˈdʒiː ˌsɛnsər/","n.","加速度传感器","The G-sensor detects harsh braking and impacts.","G-sensor 能检测急刹车和碰撞冲击。","正式名称是 accelerometer /əkˌsɛləˈrɑːmɪtər/。",0),
v("gyroscope","/ˈdʒaɪrəskoʊp/","n.","陀螺仪","With a gyroscope, we can detect sharp turns more accurately.","有了陀螺仪，急转弯识别会更准确。","加速度计 + 陀螺仪 = 六轴传感器（six-axis IMU）。",0),
v("GPS signal","/ˌdʒiː piː ˈɛs ˈsɪɡnəl/","n.","GPS 信号","In tunnels, the GPS signal may be lost for a few minutes.","在隧道里，GPS 信号可能会丢失几分钟。","GPS drift = 定位漂移。",0),
v("OBD port","/ˌoʊ biː ˈdiː pɔːrt/","n.","OBD 接口","If you plug into the OBD port, you can read fuel and engine data.","接上 OBD 接口，就能读取油耗和发动机数据。","",0,"O B D port"),
v("CAN bus","/ˈkæn bʌs/","n.","CAN 总线","On heavy trucks, engine data is read from the CAN bus.","在重卡上，发动机数据是从 CAN 总线读取的。","读作 can bus，不逐字母读。",0,"can bus"),
v("peripheral","/pəˈrɪfərəl/","n.","外设","Fuel and temperature monitoring require extra peripherals.","油量和温度监测需要额外加装外设。","重音在第二音节 pe-RI-pheral。",1),
v("fuel-level sensor","/ˈfjuːəl ˌlɛvəl ˈsɛnsər/","n.","油量传感器","A fuel-level sensor can detect fuel theft at night.","油量传感器能检测夜间偷油。","",0),
v("temperature sensor","/ˈtɛmpərətʃər ˈsɛnsər/","n.","温度传感器","Cold-chain customers need temperature sensors in the cargo area.","冷链客户需要在货厢里装温度传感器。","cold chain = 冷链。",0),
v("driver ID","/ˈdraɪvər ˌaɪ ˈdiː/","n.","司机身份识别","Drivers tap an RFID card to log in before they start driving.","司机出车前刷一下 RFID 卡登录身份。","常见方式：RFID card、iButton、face recognition（人脸识别）。",0,"driver I D"),
v("firmware","/ˈfɜːrmwɛr/","n.","固件","This issue will be fixed in the next firmware version.","这个问题会在下一个固件版本里修复。","",1),
v("OTA update","/ˌoʊ tiː ˈeɪ ˈʌpdeɪt/","n.","远程升级（over-the-air）","We can push OTA updates without sending anyone to the vehicle.","我们可以远程推送升级，不用派人到车上。","",1,"O T A update"),
v("SIM card","/ˈsɪm kɑːrd/","n.","SIM 卡","Who provides the SIM card and the data plan?","SIM 卡和流量套餐由谁提供？","SIM 读成一个词 sim。data plan = 流量套餐。",1),
v("SD card","/ˌɛs ˈdiː kɑːrd/","n.","SD 存储卡","Video is stored on the SD card and uploaded only when needed.","视频存在 SD 卡里，需要时才上传。","",0,"S D card"),
v("installation","/ˌɪnstəˈleɪʃən/","n.","安装","How long does the installation take per vehicle?","每辆车安装要多长时间？","installer = 安装工；install (v.) = 安装。",1),
v("wiring harness","/ˈwaɪərɪŋ ˌhɑːrnɪs/","n.","线束","Please check the wiring harness before you replace the device.","更换设备前请先检查线束。","",0),
v("calibration","/ˌkælɪˈbreɪʃən/","n.","标定；校准","ADAS needs calibration after installation.","ADAS 安装后需要标定。","动词 calibrate /ˈkælɪbreɪt/。",1),
v("ignition","/ɪɡˈnɪʃən/","n.","点火（国内常说的 ACC）","The device starts recording when the ignition is on.","点火后设备就开始录像。","ignition on / off = 点火 / 熄火。",0),
v("heartbeat","/ˈhɑːrtbiːt/","n.","心跳（设备定时上报）","If there's no heartbeat for 24 hours, the device shows as offline.","24 小时没有心跳，设备就显示为离线。","",0),
v("online / offline","/ˌɑːnˈlaɪn/ · /ˌɔːfˈlaɪn/","adj.","在线 / 离线","Why is this device showing offline?","这台设备为什么显示离线？","",1),
v("serial number","/ˈsɪriəl ˌnʌmbər/","n.","序列号（SN）","Could you send me the serial number of the device?","能把这台设备的序列号发给我吗？","书面常写 SN 或 Device SN。",1),
v("tampering","/ˈtæmpərɪŋ/","n.","人为破坏（遮挡镜头、拔线等）","The system sends an alert if someone is tampering with the camera.","有人破坏摄像头时，系统会发出告警。","tamper with sth = 擅自动、破坏某物。",1),
v("power consumption","/ˈpaʊər kənˌsʌmpʃən/","n.","功耗","Low power consumption matters when a truck is parked for days.","卡车停放好几天时，低功耗很关键。","battery drain = 电瓶亏电。",0),
v("field of view","/ˌfiːld əv ˈvjuː/","n.","视场角（FOV）","A wider field of view can cover more lanes.","视场角越大，能覆盖的车道越多。","",0)
]},

{ id:'A3', title:'AI 识别与驾驶事件', en:'AI Detection & Driving Events', items:[
v("ADAS","/ˈeɪdæs/","n.","高级驾驶辅助系统","ADAS warns the driver before a possible collision.","ADAS 会在可能发生碰撞前提醒司机。","通常读成一个词 AY-das。全称 Advanced Driver Assistance Systems。",1),
v("DMS","/ˌdiː ɛm ˈɛs/","n.","驾驶员状态监测（Driver Monitoring System）","DMS detects fatigue, distraction and phone use.","DMS 能识别疲劳、分心和打电话。","按字母读 D-M-S。",1,"D M S"),
v("BSD","/ˌbiː ɛs ˈdiː/","n.","盲区检测（Blind Spot Detection）","Blind spot detection is becoming a legal requirement for trucks and buses in Europe.","在欧洲，盲区检测正逐步成为卡车和公交车的法定要求。","",0,"B S D"),
v("event","/ɪˈvɛnt/","n.","事件（报警事件）","Each event includes a short video, the location and the speed.","每个事件都包含一段短视频、位置和车速。","",1),
v("alert","/əˈlɜːrt/","n./v.","告警；提醒","You can choose which events trigger a real-time alert.","你可以选择哪些事件触发实时告警。","对外优先说 alert。alarm 更像刺耳的警铃，听起来很“吵”。",1),
v("harsh braking","/ˌhɑːrʃ ˈbreɪkɪŋ/","n.","急刹车","Harsh braking often means the driver was following too closely.","急刹车往往说明司机跟车太近。","harsh 也可以换成 hard：hard braking。",1),
v("harsh acceleration","/ˌhɑːrʃ əkˌsɛləˈreɪʃən/","n.","急加速","Harsh acceleration wastes a lot of fuel.","急加速非常费油。","",0),
v("harsh cornering","/ˌhɑːrʃ ˈkɔːrnərɪŋ/","n.","急转弯","Harsh cornering with a full load can cause a rollover.","满载急转弯可能导致侧翻。","",0),
v("speeding","/ˈspiːdɪŋ/","n.","超速","Speeding is still the most common violation we see.","超速仍然是我们看到最多的违规行为。","speed limit = 限速。",0),
v("distracted driving","/dɪˈstræktɪd ˈdraɪvɪŋ/","n.","分心驾驶","Distracted driving is one of the main causes of rear-end collisions.","分心驾驶是追尾事故的主要原因之一。","rear-end collision = 追尾。",1),
v("phone use","/ˈfoʊn juːs/","n.","使用手机","The driver hears a voice warning when phone use is detected.","检测到使用手机时，司机会听到语音提醒。","use 作名词读 /juːs/，结尾是清音 s。",0),
v("smoking","/ˈsmoʊkɪŋ/","n.","抽烟","Many fleets don't allow smoking in the cab.","很多车队禁止在驾驶室里抽烟。","cab = 驾驶室。",0),
v("fatigue","/fəˈtiːɡ/","n.","疲劳","Yawning and eye closure are typical signs of fatigue.","打哈欠和闭眼是疲劳的典型表现。","重音在后：fa-TIGUE。近义词 drowsiness /ˈdraʊzinəs/（困倦）。",1),
v("seatbelt violation","/ˈsiːtbɛlt ˌvaɪəˈleɪʃən/","n.","未系安全带","Seatbelt violations usually drop quickly once drivers know they're being monitored.","司机知道自己被监测后，未系安全带的情况通常很快减少。","",0),
v("camera obstruction","/ˈkæmərə əbˈstrʌkʃən/","n.","镜头遮挡","We got a camera obstruction alert — the driver had covered the lens.","我们收到一条镜头遮挡告警——司机把镜头挡住了。","",0),
v("forward collision warning","/ˈfɔːrwərd kəˈlɪʒən ˈwɔːrnɪŋ/","n.","前向碰撞预警（FCW）","Forward collision warning gives the driver extra time to react.","前向碰撞预警让司机有更多反应时间。","",0),
v("lane departure warning","/ˈleɪn dɪˌpɑːrtʃər ˈwɔːrnɪŋ/","n.","车道偏离预警（LDW）","On narrow roads, too many lane departure warnings can annoy drivers.","在窄路上，车道偏离预警太多会让司机很烦。","",0),
v("tailgating","/ˈteɪlˌɡeɪtɪŋ/","n.","跟车过近","Tailgating is one of the riskiest behaviors on the highway.","跟车过近是高速公路上最危险的行为之一。","也说 following too closely。车距监测 = headway monitoring（HMW）。",1),
v("pedestrian detection","/pəˈdɛstriən dɪˌtɛkʃən/","n.","行人检测","Pedestrian detection is very important for city buses.","行人检测对城市公交非常重要。","",0),
v("blind spot","/ˈblaɪnd spɑːt/","n.","盲区","Many right-turn accidents happen because of the blind spot.","很多右转事故都是盲区造成的。","在英国这类靠左行驶的国家，危险的是左转。",1),
v("collision","/kəˈlɪʒən/","n.","碰撞","The video was uploaded automatically after the collision.","碰撞发生后，视频自动上传了。","",1),
v("rollover","/ˈroʊlˌoʊvər/","n.","侧翻","A rollover alert goes straight to the manager's phone.","侧翻告警会直接推送到管理者手机上。","",0),
v("near miss","/ˌnɪr ˈmɪs/","n.","险情（差点发生的事故）","For every accident, there are many near misses that nobody reports.","每起事故背后，都有许多没人上报的险情。","",1),
v("crash detection","/ˈkræʃ dɪˌtɛkʃən/","n.","碰撞（事故）检测","Crash detection is based on the G-sensor data.","碰撞检测基于 G-sensor 数据。","",0),
v("false positive","/ˌfɔːls ˈpɑːzətɪv/","n.","误报（false alarm）","With too many false positives, managers stop checking the alerts.","误报太多，管理者就不再查看告警了。","",1),
v("false negative","/ˌfɔːls ˈnɛɡətɪv/","n.","漏报（missed detection）","In safety, a false negative is worse than a false positive.","在安全领域，漏报比误报更糟糕。","",1),
v("accuracy","/ˈækjərəsi/","n.","准确率","What's the accuracy of your fatigue detection?","你们疲劳识别的准确率是多少？","被追问时最好分开讲：precision（报出来的有多少是真的）和 recall（真实发生的有多少被报出来）。",1),
v("detection rate","/dɪˈtɛkʃən ˌreɪt/","n.","检出率","We improved the detection rate without adding more false alarms.","我们在不增加误报的前提下提高了检出率。","",0),
v("threshold","/ˈθrɛʃhoʊld/","n.","阈值","We can raise the speed threshold to reduce alerts.","可以调高速度阈值来减少告警。","读 THRESH-hold，中间只有一个 h 音。",1),
v("sensitivity","/ˌsɛnsəˈtɪvəti/","n.","灵敏度","Lower sensitivity means fewer alerts, but you may miss some events.","灵敏度调低，告警会变少，但可能漏掉一些事件。","",0),
v("severity","/səˈvɛrəti/","n.","严重程度","Events are sorted by severity, so the critical ones come first.","事件按严重程度排序，最严重的排在最前面。","",0),
v("edge AI","/ˌɛdʒ ˌeɪ ˈaɪ/","n.","端侧 AI（在设备上运行）","With edge AI, the device can warn the driver even without a network.","有了端侧 AI，设备即使没网也能提醒司机。","对应 cloud AI（云端 AI）。",1,"edge A I"),
v("cloud verification","/ˈklaʊd ˌvɛrɪfɪˈkeɪʃən/","n.","云端二次校验","Events are double-checked by cloud AI before they reach the manager.","事件在推送给管理者之前，会经过云端 AI 二次校验。","",0),
v("algorithm","/ˈælɡərɪðəm/","n.","算法","Our algorithm team is working on the next version.","我们的算法团队正在开发下一个版本。","",0),
v("model","/ˈmɑːdəl/","n.","（AI）模型","We need more night-time videos to train the model.","我们需要更多夜间视频来训练模型。","注意和 device model（设备型号）区分。",0),
v("annotation","/ˌænəˈteɪʃən/","n.","数据标注（labeling）","Could you share some false alarm videos with us for annotation?","能分享一些误报视频给我们做标注吗？","",0),
v("scenario","/səˈnɛrioʊ/","n.","场景","Night driving is a difficult scenario for the camera.","夜间驾驶对摄像头来说是个困难场景。","美音 sə-NAIR-ee-oh。",1)
]},

{ id:'A4', title:'视频与数据', en:'Video & Data', items:[
v("live video","/ˌlaɪv ˈvɪdioʊ/","n.","实时视频","Can I watch live video from the office?","我能在办公室看实时视频吗？","live 作形容词读 /laɪv/（同 alive），不读 /lɪv/。",1),
v("playback","/ˈpleɪbæk/","n.","回放","Video playback is slow on this network.","在这个网络下视频回放很慢。","名词连写 playback，动词分开写 play back。",1),
v("footage","/ˈfʊtɪdʒ/","n.","录像；视频素材","Can you send me the footage from yesterday afternoon?","能把昨天下午的录像发给我吗？","不可数名词。",1),
v("clip","/klɪp/","n.","视频片段","Each event clip is about ten seconds long.","每个事件片段大约十秒。","",0),
v("video retrieval","/ˈvɪdioʊ rɪˈtriːvəl/","n.","视频调取","Video retrieval from the device takes a few minutes.","从设备调取视频需要几分钟。","动词 retrieve = 调取。",0),
v("upload","/ˈʌploʊd/ · /ʌpˈloʊd/","n./v.","上传","The video failed to upload because of a weak signal.","因为信号弱，视频上传失败了。","名词重音在前，动词重音在后。",0),
v("evidence","/ˈɛvɪdəns/","n.","证据","Video is the best evidence after an accident.","视频是事故发生后最好的证据。","不可数，不说 evidences；一条证据 = a piece of evidence。",1),
v("resolution","/ˌrɛzəˈluːʃən/","n.","分辨率","Higher resolution means more data usage.","分辨率越高，流量消耗越大。","",0),
v("frame rate","/ˈfreɪm ˌreɪt/","n.","帧率","We lowered the frame rate to save storage.","我们降低了帧率来节省存储。","fps = frames per second。",0),
v("bitrate","/ˈbɪtreɪt/","n.","码率","Bitrate affects both image quality and data cost.","码率既影响画质，也影响流量成本。","",0),
v("latency","/ˈleɪtənsi/","n.","延迟","There's about a three-second latency on live video.","实时视频大约有三秒延迟。","",0),
v("bandwidth","/ˈbændwɪdθ/","n.","带宽","Live streaming needs stable bandwidth.","实时视频流需要稳定的带宽。","",0),
v("data usage","/ˈdeɪtə ˌjuːsɪdʒ/","n.","流量消耗","Customers always ask about the monthly data usage.","客户总会问每月的流量消耗。","",1),
v("coverage","/ˈkʌvərɪdʒ/","n.","（网络）信号覆盖","In rural areas with poor coverage, the video uploads later.","在信号覆盖差的乡村地区，视频会稍后上传。","",0),
v("cloud storage","/ˈklaʊd ˌstɔːrɪdʒ/","n.","云存储","How long is the video kept in cloud storage?","视频在云存储里保留多久？","",0),
v("data retention","/ˈdeɪtə rɪˈtɛnʃən/","n.","数据保留期","The default data retention period is 90 days.","默认数据保留期是 90 天。","",0),
v("redaction","/rɪˈdækʃən/","n.","（影像）脱敏","Redaction blurs faces and license plates before the video is shared.","脱敏会在视频分享前把人脸和车牌模糊掉。","blur (v.) /blɜːr/ = 模糊处理。",0),
v("privacy","/ˈpraɪvəsi/","n.","隐私","Driver privacy is a big concern in Europe.","在欧洲，司机隐私是个大问题。","英音读 /ˈprɪvəsi/。",1),
v("GDPR","/ˌdʒiː diː piː ˈɑːr/","n.","欧盟《通用数据保护条例》","Is your platform GDPR-compliant?","你们的平台符合 GDPR 吗？","巴西对应的法规是 LGPD。",1,"G D P R"),
v("data residency","/ˈdeɪtə ˈrɛzɪdənsi/","n.","数据驻留（数据存放在哪个国家 / 地区）","Data residency is often the first question from government customers.","数据驻留往往是政府类客户问的第一个问题。","常见问法：Where is the data hosted?",0),
v("encryption","/ɪnˈkrɪpʃən/","n.","加密","Is the video encrypted in transit and at rest?","视频在传输和存储时都加密吗？","in transit = 传输中；at rest = 存储中。",0)
]},

{ id:'A5', title:'平台功能', en:'Platform Features', items:[
v("dashboard","/ˈdæʃbɔːrd/","n.","仪表盘","The dashboard shows the key numbers at a glance.","仪表盘让人一眼就能看到关键数据。","",1),
